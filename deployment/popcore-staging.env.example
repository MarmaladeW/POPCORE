# /etc/popcore/staging.env: settings for popcore-staging. Never commit the real file.
#   install -d -m 755 /etc/popcore
#   install -m 600 deployment/popcore-staging.env.example /etc/popcore/staging.env
# (systemd reads this file as root; the staging user only needs the gunicorn settings
# file in the same folder, which is installed with mode 644.)
#
# Do NOT copy production's .env here. The service forces its own database and upload
# paths and switches off the scheduler, Clover and Auth0 user management, but anything
# you add here still runs against the real services.

# The same Auth0 tenant and API as production, so the same people can log in. Add the
# staging address to the Auth0 SPA application's Allowed Callback URLs, Allowed Logout
# URLs and Allowed Web Origins.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://popcore/api

# The staging address only.
CORS_ORIGINS=https://staging.popcore.store

# Optional. Leave empty unless you are testing these features on staging.
SENTRY_DSN=
ANTHROPIC_API_KEY=
GOOGLE_SERVICE_ACCOUNT_PATH=
