# /etc/litestream.env: bucket and credentials for Litestream. Never commit the real file.
#   install -m 600 -o root -g root deployment/litestream.env.example /etc/litestream.env
# then fill in the values below: no quotes, no spaces.
#
# Cloudflare R2 (free tier: 10 GB stored, 1 million uploads and 10 million reads a month,
# no download fees). Create the bucket, then an R2 API token with "Object Read & Write"
# limited to that bucket.
#   LITESTREAM_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   LITESTREAM_REGION=auto
#
# Backblaze B2 (first 10 GB free). Create a private bucket with Lifecycle Settings "Keep
# only the last version of the file", then an application key limited to that bucket
# with Read and Write access. The region is part of the bucket's S3 endpoint.
#   LITESTREAM_ENDPOINT=https://s3.us-west-004.backblazeb2.com   (Backblaze shows it without https://)
#   LITESTREAM_REGION=us-west-004

LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Optional: a URL Litestream calls every 10 minutes while replication works, e.g. a free
# healthchecks.io check with a 10 minute period and 1 hour grace. Leave empty to skip.
LITESTREAM_HEARTBEAT_URL=
