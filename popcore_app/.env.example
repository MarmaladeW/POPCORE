# Auth0 (REQUIRED — server refuses to start if AUTH0_DOMAIN is missing)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://popcore/api
AUTH0_MGMT_CLIENT_ID=your_mgmt_client_id
AUTH0_MGMT_CLIENT_SECRET=your_mgmt_client_secret

# CORS — comma-separated list of allowed frontend origins
# In production this must be your real domain, not localhost.
CORS_ORIGINS=https://your-production-domain.com

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
APP_ENV=production
APP_RELEASE=1.0.0
SERVER_NAME=your-server-hostname

# LLM daily-report parser (optional — leave blank to use the rule parser only).
# When set, pasted daily reports are read by Claude first, with automatic
# fallback to the rule parser on any error. ~1 small call per report.
ANTHROPIC_API_KEY=
# Override the model if desired (default: claude-haiku-4-5-20251001)
LLM_PARSER_MODEL=

# Clover checkout (optional — leave blank to keep Clover disconnected). See docs/clover-checkout.md.
# Without the writer key POPCORE only reads Clover and never changes Clover orders.
CLOVER_CONNECTOR_URL=
CLOVER_CONNECTOR_PASSWORD=
CLOVER_CONNECTOR_WRITER_KEY=
CLOVER_MERCHANT_ID=
CLOVER_STORE_ID=
CLOVER_ENVIRONMENT=sandbox
CLOVER_INSTANCE=pc
# label: leave orders paid in POPCORE open on Clover, titled "Paid <date> <time>"; pay: pay them on Clover.
CLOVER_WRITEBACK=label
# Toronto date or time; older Clover orders are ignored.
CLOVER_IMPORT_SINCE=

# Website stock sync with popcore.ca (optional — leave blank to keep the website disconnected).
# A WooCommerce REST key with Read/Write access, owned by a Shop Manager user. See docs/website-sync.md.
# Nothing is written to the website until an admin turns the sync on in POPCORE (Website page).
WEBSITE_URL=
WEBSITE_KEY=
WEBSITE_SECRET=
# Extra units held back from the website on every item, on top of the daily-report hold below.
WEBSITE_KEEP_BACK=0
# The store delivery orders are filled from.
WEBSITE_DELIVERY_STORE=DT
# When a shop day starts (Toronto time): from then until that day's report is pasted, each item
# holds back the shop's best day of the last 30 reports.
WEBSITE_SHOP_OPENS=12:00
