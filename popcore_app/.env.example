# Auth0 (required)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://popcore/api
AUTH0_MGMT_CLIENT_ID=your_mgmt_client_id
AUTH0_MGMT_CLIENT_SECRET=your_mgmt_client_secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
APP_ENV=production
APP_RELEASE=1.0.0
SERVER_NAME=your-server-hostname
