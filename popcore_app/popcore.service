# systemd unit file for POPCORE
#
# DO NOT edit this file directly on the server — edit the copy in the repo
# (popcore_app/popcore.service) and re-run setup_production.sh to apply.
#
# The setup_production.sh script installs this to
#   /etc/systemd/system/popcore.service
# with __REPO_DIR__, __VENV_DIR__, and __RUN_USER__ replaced by real paths.

[Unit]
Description=POPCORE Inventory System (Gunicorn)
Documentation=file:__REPO_DIR__/README.md
After=network.target
# If you add PostgreSQL later: After=network.target postgresql.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__

WorkingDirectory=__REPO_DIR__/popcore_app

# Load production secrets from .env (never commit this file)
EnvironmentFile=__REPO_DIR__/popcore_app/.env

# Start Gunicorn; -c picks up gunicorn.conf.py (workers, bind, timeout, etc.)
ExecStart=__VENV_DIR__/bin/gunicorn -c gunicorn.conf.py app:app

# Graceful reload: send HUP to master process (workers drain then restart)
ExecReload=/bin/kill -s HUP $MAINPID

# Write access + error logs to server.log (logrotate handles rotation)
StandardOutput=append:__REPO_DIR__/popcore_app/server.log
StandardError=append:__REPO_DIR__/popcore_app/server.log

# Restart automatically on crash; wait 5 s before each attempt
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
